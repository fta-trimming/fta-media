[{"n": 1, "html": "<div class='tag' style='background:#f6d77a;color:#24402f'>スタッフ育成</div><h1>教えたのに、<br><span class='y'>できない。</span></h1><div class='art' style='top:420px;height:640px'><img src='k1.png'></div><div class='note' style='bottom:110px'>原因は、教える側の<span class='g'>「感覚目線」</span>かもしれません</div>"}, {"n": 2, "html": "<div class='tag'>原因</div><h1>頭で説明しても、<br><span class='y'>体に入らない</span></h1><div class='art' style='top:420px;height:600px'><img src='k2.png'></div><div class='note'>言われるがままの作業だと、<br>自分の感覚として身につかない</div>"}, {"n": 3, "html": "<div class='tag'>くらべる</div><h1>教え方で、<br><span class='y'>伸び方が変わる</span></h1><div class='art' style='top:420px;height:480px'><img src='k3.png'></div><div class='cmp'><div class='x'>×<br>やり方を頭で説明<br>→ できない</div><div class='o'>○<br>流れを最後まで体で<br>→ できる</div></div>"}, {"n": 4, "html": "<div class='tag'>教え方 ①</div><h1>難しいことは<br><span class='y'>言わない</span></h1><div class='art' style='top:420px;height:600px'><img src='k4.png'></div><div class='note'>まず、作業の流れを<br>最後まで教える</div>"}, {"n": 5, "html": "<div class='tag'>教え方 ②</div><h1>ワンコに負担がなければ、<br><span class='y'>最後まで</span></h1><div class='art' style='top:420px;height:600px'><img src='k5.png'></div><div class='note'>途中で止めずに、<br>最後まで通して経験してもらう</div>"}, {"n": 6, "html": "<div class='tag'>教え方 ③</div><h1>自分の感覚になるまで、<br><span class='y'>くり返す</span></h1><div class='art' style='top:420px;height:600px'><img src='k6.png'></div><div class='note'>体験をくり返すうちに、<br>流れが自分のものになる</div>"}, {"n": 7, "html": "<div class='tag'>育った合図</div><h1>最後まで、<br><span class='y'>自分のやり方で</span></h1><div class='art' style='top:420px;height:600px'><img src='k7.png'></div><div class='note'>自分のやり方で最後まで進められたら、<br>一人で任せていい合図</div>"}, {"n": 8, "html": "<div class='tag'>まとめ</div><h1>教える前に、<br><span class='y'>この3つ</span></h1><div class='art' style='top:420px;height:260px'><img src='k8.png'></div><div class='list' style='top:700px;gap:16px'><div><b>01</b>難しいことは言わない</div><div><b>02</b>流れを最後まで体で</div><div><b>03</b>自分のやり方で最後まで＝合図</div></div><div class='band'>保存して、次に教える前に見返してね</div><div class='nxt'>来週：空いた枠を、新しいお客様で埋める話</div>"}]